# ClaimGuard — environment (all blank; copy to .env and fill only what you need)
# No secrets are ever committed. The gate never handles a private key or seed:
# signing happens inside the Binance App via the `baw` CLI.

# Expected wallet address (must match `baw wallet status`)
WALLET_ADDRESS=
# BSC RPC endpoint (public default is fine for read-only recon)
BSC_RPC_URL=https://bsc-dataseed.binance.org/
